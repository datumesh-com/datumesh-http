# The one site block for khatm's Caddyfile (/srv/khatm/deploy/Caddyfile on quran-box). It goes
# into khatm's source on the operator's machine: khatm's deploy.sh rsyncs that source with
# --delete, so a block added only on the server is lost on khatm's next deploy. Apply, then:
#   cd /srv/khatm && docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# No `import cf`: datumesh.com is not shown to be covered by khatm's Cloudflare token, so Caddy
# uses the HTTP-01 challenge. Cloudflare forwards http://datumesh.com/.well-known/acme-challenge/*
# to this server (a Worker route with no script), and the apex A record must point at
# 5.189.160.91 before the reload.
#
# Only Cloudflare may connect (the list below; refresh it from https://www.cloudflare.com/ips/
# with deploy/prod/cf_ips.sh, see RUNBOOK.md). The client's address reaches the mesh as the last
# X-Forwarded-For entry, from CF-Connecting-IP, which only Cloudflare can set once the rest is refused.
# Cloudflare IP list as of 2026-11-16 (api.cloudflare.com/client/v4/ips etag 38f79d050aa027e3be3865e495dcc9bc).
datumesh.com {
	@notcf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @notcf 403
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy datumesh-mesh:8080 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
