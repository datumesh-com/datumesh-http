# TLS front of the test mesh: automatic HTTPS (here: Caddy's internal CA, until the DNS name resolves),
# HSTS, the mesh behind it. Access log: JSON, without query strings, headers or job ids.
{
	admin 127.0.0.1:2019
	# HTTP/1.1 and HTTP/2 only: 443/udp is not published.
	servers {
		protocols h1 h2
	}
}

(mesh) {
	header Strict-Transport-Security "max-age=31536000"
	encode gzip
	# The licence of the seed's one restricted cell (deploy/seed/ecb.py): a test licence, not open.
	header /licences/restricted-test Content-Type "text/plain; charset=utf-8"
	respond /licences/restricted-test "Restricted test licence (mesh-test.datumesh.com). The cells under this licence are synthetic test data. It is not an open licence: it permits no delivery beyond the test mesh's own answers, and exists only so that clients can test how they treat a licence that is not open." 200
	reverse_proxy mesh:8080 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# One filter per field: a job URL loses its id (a capability), any URL its query.
				request>uri regexp "^(/jobs/)[0-9a-f]+.*$|\?.*$" "${1}"
				request>headers delete
				resp_headers delete
			}
		}
	}
}

mesh-test.datumesh.com {
	tls internal
	import mesh
}
